# GDB init for remote debugging on Pi via DebugLantern
# Sourced by launch.json autorun: "source .gdbinit-remote"
# (cwd is set to the workspace root by launch.json)
#
# NOTE: sysroot, solib-search-path, and debuginfod are configured
# via -iex in scripts/gdb-remote.sh (BEFORE the target remote
# connection) so GDB resolves libraries locally from the start.

set confirm off

# Flutter engine debug symbols (~212MB) — loaded automatically via sysroot
# symlinks. To load the separate .dbgsyms file (if engine is stripped), uncomment:
# add-symbol-file ./dist/pi-debug-symbols/libflutter_engine.dbgsyms
