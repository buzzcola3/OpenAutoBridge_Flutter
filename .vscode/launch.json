{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug openautoflutter_example (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/example/build/linux/x64/release/bundle/openautoflutter_example",
      "args": [],
      "cwd": "${workspaceFolder}/example/build/linux/x64/release/bundle",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${workspaceFolder}/example/build/linux/x64/release/bundle/lib"
        }
      ],
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "description": "Enable pretty-printing for gdb"
        }
      ],
      "preLaunchTask": "docker: flutter build linux (example)",
      "externalConsole": false
    },
    {
      "name": "Debug on Pi (DebugLantern)",
      "type": "gdb",
      "request": "attach",
      "executable": "${workspaceFolder}/dist/flutter-drm-arm64-debug/flutter-drm-embedder",
      "remote": true,
      "target": "| ${workspaceFolder}/scripts/dl-connect.sh",
      "cwd": "${workspaceFolder}",
      "gdbpath": "${workspaceFolder}/scripts/gdb-remote.sh",
      "autorun": [
        "source .gdbinit-remote"
      ],
      "printCalls": false
    },
    {
      "name": "Deploy & Debug on Pi (DebugLantern)",
      "type": "gdb",
      "request": "attach",
      "executable": "${workspaceFolder}/dist/flutter-drm-arm64-debug/flutter-drm-embedder",
      "remote": true,
      "target": "| ${workspaceFolder}/scripts/dl-connect.sh",
      "cwd": "${workspaceFolder}",
      "gdbpath": "${workspaceFolder}/scripts/gdb-remote.sh",
      "preLaunchTask": "debuglantern: deploy & debug",
      "autorun": [
        "source .gdbinit-remote"
      ],
      "printCalls": false
    },
    {
      "name": "Upload & Debug on Pi (DebugLantern)",
      "type": "gdb",
      "request": "attach",
      "executable": "${workspaceFolder}/dist/flutter-drm-arm64-debug/flutter-drm-embedder",
      "remote": true,
      "target": "| ${workspaceFolder}/scripts/dl-connect.sh",
      "cwd": "${workspaceFolder}",
      "gdbpath": "${workspaceFolder}/scripts/gdb-remote.sh",
      "preLaunchTask": "debuglantern: upload existing bundle",
      "autorun": [
        "source .gdbinit-remote"
      ],
      "printCalls": false
    },
    {
      "name": "Clean example bundle (docker)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/usr/bin/env",
      "args": ["true"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "docker: flutter clean (example)",
      "externalConsole": false
    }
  ]
}